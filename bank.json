    {
      "id": "day002",
      "title": "Both Sides Brawl",
      "topic": "Equations with variables on both sides",
      "topicIndex": 2,
      "satDomain": "Algebra",
      "level": 4.7,
      "boss": false,
      "video": "videos/day002.mp4",
      "question": {
        "prompt": "5x + 9 = 2x − 12. What is the value of x?",
        "choices": [
          "7",
          "−1",
          "−7",
          "−3"
        ],
        "answer": 2,
        "explain": "Subtract 2x from both sides: 3x + 9 = −12. Subtract 9: 3x = −21, so x = −7. Check: 5(−7) + 9 = −26 and 2(−7) − 12 = −26."
      },
      "rapid": [
        {
          "prompt": "8x − 5 = 3x + 20. What is x?",
          "choices": [
            "5",
            "3",
            "25",
            "−5"
          ],
          "answer": 0,
          "why": "Subtract 3x: 5x − 5 = 20. Add 5: 5x = 25, so x = 5."
        },
        {
          "prompt": "2x + 11 = 6x − 13. What is x?",
          "choices": [
            "−6",
            "3",
            "6",
            "0.5"
          ],
          "answer": 2,
          "why": "Subtract 2x: 11 = 4x − 13. Add 13: 24 = 4x, so x = 6."
        },
        {
          "prompt": "4(x + 3) = 2x + 20. What is x?",
          "choices": [
            "8.5",
            "4",
            "8",
            "−4"
          ],
          "answer": 1,
          "why": "Distribute first: 4x + 12 = 2x + 20 → 2x = 8 → x = 4."
        },
        {
          "prompt": "Arcade A: $24 to get in + $3 a game. Arcade B: $7 a game. After how many games do they cost the same?",
          "choices": [
            "8",
            "2.4",
            "6",
            "4"
          ],
          "answer": 2,
          "why": "24 + 3g = 7g → 24 = 4g → g = 6 games."
        },
        {
          "prompt": "If 7x + 5 = 3x + 29, what is 2x + 1?",
          "choices": [
            "6",
            "13",
            "25",
            "12"
          ],
          "answer": 1,
          "why": "4x = 24, so 2x = 12 and 2x + 1 = 13. Answer the question they asked!"
        }
      ],
